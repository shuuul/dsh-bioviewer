{
  "name": "dsh-bioviewer",
  "version": "0.1.0",
  "description": "View biomolecular structures, cryo-EM maps and small molecules from the filesystem inside DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "verify:fast": "bun run lint && bun run typecheck && bun run build && bun test",
    "verify": "bun run verify:fast",
    "prepare": "husky"
  },
  "dependencies": {
    "@molstudio/core": "^0.1.4",
    "@molstudio/react": "^0.1.4",
    "molstar": "^5.13.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "dsh-better-sidebar": "^0.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dsh-better-sidebar": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --deny-warnings"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
